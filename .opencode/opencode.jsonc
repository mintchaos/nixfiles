{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "nixos": {
        "type": "local",
        "command": ["nix", "run", "github:utensils/mcp-nixos/v3.1.1", "--"],
        // First run builds mcp-nixos; give it more than the 30s default.
        "timeout": { "startup": 120000 },
      },
    },
  },
}
